# 复制为 .env 后修改

# ---- docker-compose.yml（自带 Caddy 自动 HTTPS + SQLite）用 ----
HUB_DOMAIN=hub.example.com

# ---- docker-compose.lucky-mysql.yml（已有 Lucky + MySQL）用 ----
HUB_DATABASE_URL=mysql+pymysql://rosdpi_hub:改成强密码@host.docker.internal:3306/rosdpi_hub?charset=utf8mb4

# ---- 两种都要 ----
ADMIN_PASSWORD=改成强密码
