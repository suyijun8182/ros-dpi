# ---------- 数据库（docker-compose 自带的 MySQL） ----------
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# 使用外部 MySQL 时，在 docker-compose.yml 里改 DATABASE_URL：
# DATABASE_URL=mysql+pymysql://user:pass@192.168.1.10:3306/rosdpi?charset=utf8mb4

# ---------- 基本 ----------
TZ=Asia/Shanghai
# 首次启动的管理员密码（用户名 admin）；留空则在登录页设置
ADMIN_PASSWORD=
# LAN 网段（逗号分隔），也可以在界面里改。双 NAT（WAN 也是私网地址）时务必只填内网实际网段
LAN_CIDRS=192.168.88.0/24

# ---------- RouterOS 只读 API（可选：主机名、WAN 速率、自动发现 IPv6 前缀） ----------
# ROS_URL=https://192.168.88.1
# ROS_USER=rosdpi
# ROS_PASSWORD=
# ROS_VERIFY_TLS=false
# WAN_INTERFACE=pppoe-out1

# ---------- 端口（与 docker-compose.yml 的端口映射保持一致） ----------
# HTTP_PORT=8080
# IPFIX_PORT=2055
# TZSP_PORT=37008

# ---------- 数据保留天数 ----------
# RETENTION_MINUTE_DAYS=2
# RETENTION_HOUR_DAYS=45
# RETENTION_DAY_DAYS=730
# RETENTION_DOMAIN_DAYS=31
