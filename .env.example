# ROS-DPI 全部可用环境变量（参考用）
# docker-compose.yml 已经写好了常用项；需要其它项时，加到 compose 的 environment 下即可。

# ---------- 数据库 ----------
# 默认留空：首次打开网页时在安装向导里填写 MySQL 信息（保存在 data/db_config.json）。
# 设置后跳过安装向导（适合自动化部署）。库不存在时会自动创建（账号需有建库权限），表由程序自动建立。
# DATABASE_URL=mysql+pymysql://rosdpi:password@192.168.1.10:3306/rosdpi?charset=utf8mb4

# ---------- 基本 ----------
TZ=Asia/Shanghai
# JWT 签名密钥：留空时首次启动自动生成并保存到数据库；多实例部署或想让重启后 token 仍有效时设置
# SECRET_KEY=
# 数据目录（保存安装向导的数据库配置、ASN / OUI 库等）；Docker 里对应挂载的 /app/data
# DATA_DIR=./data
# 首次启动的管理员密码（用户名 admin）；留空则在登录页设置
ADMIN_PASSWORD=
# LAN 网段（逗号分隔），也可以在界面里改。双 NAT（WAN 也是私网地址）时务必只填内网实际网段
LAN_CIDRS=192.168.88.0/24

# ---------- RouterOS 只读 API（可选：主机名、WAN 速率、自动发现 IPv6 前缀） ----------
# ROS_URL=https://192.168.88.1
# ROS_USER=rosdpi
# ROS_PASSWORD=
# ROS_VERIFY_TLS=false
# WAN_INTERFACE=pppoe-out1

# RouterOS 完整轮询间隔 / WAN 口速率采样间隔（实时流量图）
# ROS_POLL_SECONDS=30
# ROS_RATE_SECONDS=5

# ---------- 旁路代理与内网 DNS（可选，建议在网页 系统设置 → 外部数据源 里填写，网页填写的优先） ----------
# sing-box / Clash 兼容的 external_controller 地址与密钥：按终端和域名统计走代理的流量
# SINGBOX_URL=http://192.168.1.2:9090
# SINGBOX_SECRET=
# 旁路代理自身的 IP（逗号分隔），留空时取 SINGBOX_URL 里的地址
# PROXY_IPS=
# FakeIP 地址段（sing-box 默认 198.18.0.0/15 与 fc00::/18）
# FAKEIP_CIDRS=198.18.0.0/15,fc00::/18
# MosDNS 审计 API 地址：知道每台终端查了哪个域名
# MOSDNS_URL=http://192.168.1.3:9099

# ---------- 识别库 ----------
# 自动下载 iptoasn.com 的 IP→ASN 库（公有领域，每天更新）；没有外网时设为 false
# ASN_DB=true
# 自动下载 IEEE MAC 厂商库（识别终端类型）；没有外网时设为 false
# OUI_DB=true
# v2fly 规则每天自动检查更新（可在网页 识别规则 → 识别库 里关闭）

# ---------- 端口（与 docker-compose.yml 的端口映射保持一致） ----------
# HTTP_PORT=8080
# IPFIX_PORT=2055
# TZSP_PORT=37008

# ---------- 数据保留天数 ----------
# RETENTION_MINUTE_DAYS=2
# RETENTION_HOUR_DAYS=45
# RETENTION_DAY_DAYS=730
# RETENTION_DOMAIN_DAYS=31
# RETENTION_LOG_DAYS=30       # 访问日志（审计）
# RETENTION_EVENT_DAYS=180    # 审计事件、操作日志
# 以上留存天数也可以在网页 系统设置 → 日志与留存 里改，网页优先
